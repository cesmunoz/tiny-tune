# Optional advanced overrides. By default Tiny Tune uses librespot's client
# configuration and requires no Spotify developer setup.
# TINY_TUNE_SPOTIFY_CLIENT_ID=your-compatible-client-id
# TINY_TUNE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8898/login

# Optional. Defaults to tiny_tune=info.
RUST_LOG=tiny_tune=info
